  ObjectNames:
  - "\uBB3C\uC790 \uC0C1\uC790"
  - "\uB0A1\uC740 \uD0C1\uC790"
  - "\uC624\uB77D\uAE30"
  - "\uBCF5\uB3C4\uB85C"
  - 
  - 
  - 
  - 
  - "\uAD00\uB9AC\uC2E4 \uC120\uBC18"
  ObjectDescriptions:
  - "\uB69C\uAED1\uC774 \uB2EB\uD78C \uBB3C\uC790 \uC0C1\uC790\uB2E4.\n\uBAA9\uC7AC\uC640 \uACE0\uCCA0, \uCC9C\uC774 \uB4E4\uC5B4 \uC788\uC744 \uAC83 \uAC19\uB2E4."
  - "\uB0A1\uC740 \uD0C1\uC790 \uC704\uC5D0 \uBA39\uC744 \uAC83\uACFC \uBB3C\uC774 \uB0A8\uC544 \uC788\uB2E4.\n\uD310\uC790\uC640 \uACE0\uCCA0\uB3C4 \uB72F\uC5B4\uB0BC \uC218 \uC788\uACA0\uB2E4."
  - "\uC624\uB77D\uAE30 \uC815\uBE44\uD310\uC774 \uB2E8\uB2E8\uD788 \uB2EB\uD600 \uC788\uB2E4.\n\uC9C0\uB81B\uB300\uB85C \uC5F4\uBA74 \uC548\uCABD\uC744 \uC218\uC0C9\uD560 \uC218 \uC788\uB2E4."
  - "\uC624\uB77D\uC2E4 \uC548\uCABD \uBCF5\uB3C4\uB85C \uC774\uC5B4\uC9C0\uB294 \uBB38\uC785\uB2C8\uB2E4."
  - 
  - 
  - 
  - 
  - "\uBB34\uC5B8\uAC00\uAC00 \uBAA8\uC544 \uB454 \uBB3C\uAC74 \uB354\uBBF8\uC785\uB2C8\uB2E4.\n\uAD74\uC774 \uBE48 \uD2C8\uC5D0\uB9CC \uC190\uB308 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  MemberContent: {fileID: 9114084116587621553}

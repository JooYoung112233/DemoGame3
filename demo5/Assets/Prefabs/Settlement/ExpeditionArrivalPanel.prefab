  SurpriseBody: "\uBC29\uC5D0 \uB4E4\uC5B4\uC11C\uC790 \uBB34\uC5B8\uAC00\uAC00 \uBA48\uCDB0 \uC11C \uC788\uC2B5\uB2C8\uB2E4.\n\uBBF8\uB9AC \uB4E3\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
  LingerLine: "\uB2E4\uC74C \uD134 \uB4A4 \uC624\uB798 \uBA38\uBB3E:\n\uC704\uD5D8\uB3C4\uAC00 1 \uC624\uB985\uB2C8\uB2E4."
  NoticedBody: "\uACC1\uC5D0 \uC788\uB358 \uBB34\uC5B8\uAC00\uAC00 \uC18C\uB9AC\uB97C \uC54C\uC544\uCC58\uC2B5\uB2C8\uB2E4.\n\uC218\uC0C9\uC744 \uBA48\uCD94\uACE0 \uBAB8\uC744 \uB0AE\uCDA5\uB2C8\uB2E4."

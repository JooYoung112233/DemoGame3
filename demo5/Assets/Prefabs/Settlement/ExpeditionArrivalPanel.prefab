  ThenTo: "{0}\uB85C"
  StatusHeardHere: "\uADF8\uB2E4\uC74C \uD134 \uC774 \uBC29\uC73C\uB85C \uC635\uB2C8\uB2E4."
  HeardSurpriseBody: "\uBC29\uC5D0 \uB4E4\uC5B4\uC11C\uC790 \uB4E4\uC740 \uB300\uB85C \uBB34\uC5B8\uAC00\uAC00 \uC11C \uC788\uC2B5\uB2C8\uB2E4.\n\uBAB8\uC744 \uB0AE\uCDA5\uB2C8\uB2E4."
  MetBody: "\uC608\uACE0\uB300\uB85C \uBB34\uC5B8\uAC00\uAC00 \uB4E4\uC5B4\uC654\uC2B5\uB2C8\uB2E4.\n\uC218\uC0C9\uC744 \uBA48\uCD94\uACE0 \uBAB8\uC744 \uB0AE\uCDA5\uB2C8\uB2E4."
  IntroTitle: "\uB450 \uBC88\uC9F8 \uBC29\uBB38 \xB7 \uC7A5\uC18C \uD310"
  IntroBody: "\uB0A8\uC740 \uD134 \uC548\uC5D0 \uC218\uC0C9\uD558\uACE0 \uBE60\uC838\uB098\uAC00\uC138\uC694.\n\uC18C\uC74C\uC774 \uC313\uC774\uBA74 \uC704\uD5D8\uB3C4\uAC00 \uC624\uB974\uACE0, \uD070 \uC18C\uB9AC\uB97C \uB0B8 \uBC29\uC744 \uBB34\uC5B8\uAC00\uAC00 \uCC3E\uC544\uC635\uB2C8\uB2E4.\n\uBB38 \uC704 \uD45C\uC2DC\uB294 \uD55C \uD134 \uC804 \uC608\uACE0\uC785\uB2C8\uB2E4 \xB7 \uBAA8\uB450 \uC228\uC8FD\uC774\uBA74 \uC9C0\uB098\uAC11\uB2C8\uB2E4.\n\uB300\uC6D0\uB9C8\uB2E4 \uD589\uB3D9\uC744 \uBC30\uC815\uD558\uACE0 '\uD134 \uC9C4\uD589'\uC744 \uB204\uB974\uC138\uC694."
  DenEmptyShelf: "\uC870\uC6A9\uD568 \xB7 \uBE48 \uC120\uBC18"
  DenReturning: "\uBB34\uC5B8\uAC00\uAC00 \uAD00\uB9AC\uC2E4\uB85C \uB3CC\uC544\uC624\uB294 \uC911\uC785\uB2C8\uB2E4.\n\uC774\uBC88 \uD134\uC5D0\uB294 \uC120\uBC18\uC744 \uB4A4\uC9C8 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  DangerRoseLine: "\uC704\uD5D8\uB3C4\uAC00 \uC62C\uB790\uC2B5\uB2C8\uB2E4 \xB7 {0}\n{1}"
  HuntLine: "\uBB34\uC5B8\uAC00\uAC00 \uC6D0\uC815\uB300\uB97C \uCAD3\uAE30 \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uC228\uC8FD\uC5EC\uB3C4 \uC9C0\uB098\uAC00\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  DangerMeaning:
  - "\uAD74\uC5D0\uC11C \uC7A0\uB4E4\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uAE68\uC5B4 \uC788\uC2B5\uB2C8\uB2E4 \xB7 \uD070 \uC18C\uB9AC\uB97C \uB0B8 \uBC29\uC744 \uAE30\uC5B5\uD569\uB2C8\uB2E4."
  - "\uAE30\uC5B5\uD55C \uBC29\uC774 \uC788\uC73C\uBA74 \uCC3E\uC544 \uB098\uC12D\uB2C8\uB2E4."
  - "\uC6D0\uC815\uB300\uB97C \uCAD3\uC2B5\uB2C8\uB2E4."
  ItemTurnQuiet: "\uC18C\uC74C \uC5C6\uC74C \xB7 \uC228\uC8FD\uC774\uAE30 \uC544\uB2D8 \xB7 \uBB34\uC5B8\uAC00\uB294 \uC608\uACE0\uB300\uB85C \uC6C0\uC9C1\uC785\uB2C8\uB2E4"
  ItemTurnPaused: "\uC18C\uC74C \uC5C6\uC74C \xB7 \uC228\uC8FD\uC774\uAE30 \uC544\uB2D8 \xB7 \uBC30\uC815\uD55C \uD589\uB3D9\uC740 \uC774\uBC88 \uD134 \uBA48\uCDA4"
  ItemTurnMeets: "<color=#A6331F>\uC774\uBC88 \uD134 \uBB34\uC5B8\uAC00\uAC00 \uB4E4\uC5B4\uC635\uB2C8\uB2E4 \xB7 \uC0AC\uC6A9\uD558\uBA74 \uB9C8\uC8FC\uCE69\uB2C8\uB2E4</color>"

  m_Script: {fileID: 11500000, guid: d781ef2261f71fe40960a9454a31b91b, type: 3}
  m_Name: PartyRoster
  m_EditorClassIdentifier: Assembly-CSharp::Demo5.FrontEnd.PartyRoster
  Candidates:
  - Id: scout
    DisplayName: "\uD0D0\uD5D8\uAC00 1"
    Description: "\uC0C8\uB85C\uC6B4 \uACF3\uC744 \uCC3E\uB294 \uB370\n\uB2A5\uC219\uD558\uB2E4."
    TraitTitle: "\uAE38\uC744 \uC77D\uB294 \uB208"
    TraitDescription: "\uB0AF\uC120 \uC7A5\uC18C\uC5D0\uC11C\uB3C4 \uC791\uC740 \uD754\uC801\uC744 \uB193\uCE58\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uC218\uC0C9\uD560 \uACF3\uACFC \uB3CC\uC544\uC62C \uAE38\uC744 \uBA3C\uC800 \uC0B4\uD54D\uB2C8\uB2E4."
    Characteristics: "\uD638\uAE30\uC2EC\uC774 \uB9CE\uACE0 \uC8FC\uBCC0\uC744 \uC138\uC2EC\uD558\uAC8C \uAD00\uCC30\uD569\uB2C8\uB2E4.\n\uC55E\uC7A5\uC11C\uC11C \uAE38\uC744 \uCC3E\uB294 \uC77C\uC744 \uC88B\uC544\uD569\uB2C8\uB2E4.\n\uC0C8\uB85C\uC6B4 \uBC1C\uACAC \uC55E\uC5D0\uC11C\uB294 \uC2E0\uC911\uD568\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."
    BagCapacity: 3
    Health: 3
    Aim: 0
    Portrait: {fileID: 21300000, guid: 307d0a624101af7458e196b677f82ac1, type: 3}
  - Id: mechanic
    DisplayName: "\uC815\uBE44\uACF5"
    Description: "\uB9DD\uAC00\uC9C4 \uAC83\uC744\n\uACE0\uCE60 \uC218 \uC788\uB2E4."
    TraitTitle: "\uACE0\uCCD0 \uC4F0\uB294 \uC190"
    TraitDescription: "\uB9DD\uAC00\uC9C4 \uBB3C\uAC74\uC5D0\uC11C\uB3C4 \uC4F8 \uB9CC\uD55C \uBD80\uBD84\uC744 \uCC3E\uC2B5\uB2C8\uB2E4.\n\uB3C4\uAD6C\uB97C \uCC59\uACA8 \uC124\uBE44\uB97C \uC0B4\uD53C\uB294 \uC5ED\uD560\uC774 \uC5B4\uC6B8\uB9BD\uB2C8\uB2E4."
    Characteristics: "\uB9D0\uBCF4\uB2E4 \uC190\uC774 \uBA3C\uC800 \uC6C0\uC9C1\uC774\uB294 \uC2E4\uC6A9\uC801\uC778 \uC131\uACA9\uC785\uB2C8\uB2E4.\n\uBD80\uD488\uC744 \uBC84\uB9AC\uC9C0 \uC54A\uACE0 \uCC28\uACE1\uCC28\uACE1 \uBAA8\uC74D\uB2C8\uB2E4.\n\uB3C4\uAD6C\uC640 \uC7AC\uB8CC\uAC00 \uC788\uC5B4\uC57C \uC2E4\uB825\uC744 \uBC1C\uD718\uD569\uB2C8\uB2E4."
    BagCapacity: 4
    Health: 3
    Aim: 0
    Portrait: {fileID: 21300000, guid: 1190c245401076d44a2a52c63674a584, type: 3}
  - Id: medic
    DisplayName: "\uC758\uBB34\uAD00"
    Description: "\uBD80\uC0C1\uC744 \uB3CC\uBCF4\uACE0\n\uC9C0\uCF1C\uBCF8\uB2E4."
    TraitTitle: "\uC0C1\uCC98\uB97C \uC0B4\uD53C\uB294 \uB208"
    TraitDescription: "\uB3D9\uB8CC\uC758 \uC791\uC740 \uC774\uC0C1\uB3C4 \uB208\uC5EC\uACA8\uBD05\uB2C8\uB2E4.\n\uBD80\uC0C1\uC790\uB97C \uB3CC\uBCF4\uACE0 \uD68C\uBCF5\uC744 \uB3D5\uB294 \uC5ED\uD560\uC785\uB2C8\uB2E4."
    Characteristics: "\uCE68\uCC29\uD558\uACE0 \uB2E4\uB978 \uC0AC\uB78C\uC758 \uC0C1\uD0DC\uB97C \uBA3C\uC800 \uC0B4\uD54D\uB2C8\uB2E4.\n\uC704\uD5D8\uD55C \uC0C1\uD669\uC5D0\uC11C\uB3C4 \uB3D9\uB8CC\uB97C \uB450\uACE0 \uAC00\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uC758\uC57D\uD488\uC744 \uC5B8\uC81C \uC0AC\uC6A9\uD560\uC9C0 \uC2E0\uC911\uD558\uAC8C \uD310\uB2E8\uD569\uB2C8\uB2E4."
    BagCapacity: 3
    Health: 4
    Aim: 0
    Portrait: {fileID: 21300000, guid: 103ebc697b188294b8a8c5dcfc9c9f2b, type: 3}
  - Id: cook
    DisplayName: "\uC694\uB9AC\uC0AC"
    Description: "\uC2DD\uC7AC\uB8CC\uB97C \uC870\uAE08 \uB354\n\uD65C\uC6A9\uD55C\uB2E4."
    TraitTitle: "\uD55C \uB07C\uC758 \uC628\uAE30"
    TraitDescription: "\uB0A8\uC740 \uC2DD\uC7AC\uB8CC\uB85C \uD568\uAED8 \uBA39\uC744 \uD55C \uB07C\uB97C \uACE0\uBBFC\uD569\uB2C8\uB2E4.\n\uC815\uCC29\uC9C0\uC758 \uC2DD\uC0AC\uC640 \uC2DD\uB7C9 \uC815\uB9AC\uC5D0 \uC5B4\uC6B8\uB9BD\uB2C8\uB2E4."
    Characteristics: "\uC0AC\uC18C\uD55C \uC77C\uC0C1\uC744 \uC18C\uC911\uD788 \uC5EC\uAE30\uB294 \uC131\uACA9\uC785\uB2C8\uB2E4.\n\uC2DD\uC7AC\uB8CC\uC758 \uC0C1\uD0DC\uC640 \uB0A8\uC740 \uC591\uC744 \uC790\uC8FC \uD655\uC778\uD569\uB2C8\uB2E4.\n\uC81C\uB300\uB85C \uC694\uB9AC\uD558\uB824\uBA74 \uC7AC\uB8CC\uC640 \uC124\uBE44\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    BagCapacity: 4
    Health: 4
    Aim: 0
    Portrait: {fileID: 21300000, guid: b1d230446365ade44a204083346e23b6, type: 3}
  - Id: researcher
    DisplayName: "\uC5F0\uAD6C\uC790"
    Description: "\uC0C8\uB85C\uC6B4 \uC815\uBCF4\uB97C\n\uAE30\uB85D\uD55C\uB2E4."
    TraitTitle: "\uD754\uC801\uC744 \uC787\uB294 \uAE30\uB85D"
    TraitDescription: "\uBA54\uBAA8\uC640 \uB0AF\uC120 \uBB3C\uAC74\uC5D0\uC11C \uB2E8\uC11C\uB97C \uCC3E\uC2B5\uB2C8\uB2E4.\n\uBAA8\uC740 \uC815\uBCF4\uB97C \uC815\uB9AC\uD558\uACE0 \uC758\uBBF8\uB97C \uC9DA\uC5B4 \uBD05\uB2C8\uB2E4."
    Characteristics: "\uAD81\uAE08\uD55C \uAC83\uC740 \uAE30\uB85D\uD558\uBA70 \uCC28\uADFC\uCC28\uADFC \uC0B4\uD3B4\uBD05\uB2C8\uB2E4.\n\uD769\uC5B4\uC9C4 \uC815\uBCF4\uC758 \uC5F0\uACB0\uC744 \uCC3E\uB294 \uC77C\uC744 \uC88B\uC544\uD569\uB2C8\uB2E4.\n\uC870\uC0AC\uC5D0 \uBAB0\uB450\uD560 \uB54C\uB294 \uB3D9\uB8CC\uC758 \uACBD\uACC4\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    BagCapacity: 3
    Health: 3
    Aim: 0
    Portrait: {fileID: 21300000, guid: d029537b4e1ddbc4e8f72d31c18ad646, type: 3}
  - Id: guard
    DisplayName: "\uACBD\uBE44\uC6D0"
    Description: "\uC8FC\uBCC0\uC744 \uACBD\uACC4\uD558\uACE0\n\uC9C0\uD0A8\uB2E4."
    TraitTitle: "\uC8FC\uBCC0\uC744 \uC9C0\uD0A4\uB294 \uB208"
    TraitDescription: "\uC8FC\uBCC0\uC758 \uC18C\uB9AC\uC640 \uC6C0\uC9C1\uC784\uC744 \uACBD\uACC4\uD569\uB2C8\uB2E4.\n\uB3D9\uB8CC\uAC00 \uC218\uC0C9\uD558\uB294 \uB3D9\uC548 \uC704\uD5D8\uC744 \uC0B4\uD53C\uB294 \uC5ED\uD560\uC785\uB2C8\uB2E4."
    Characteristics: "\uCC45\uC784\uAC10\uC774 \uAC15\uD558\uACE0 \uBA3C\uC800 \uC8FC\uBCC0\uC744 \uD655\uC778\uD569\uB2C8\uB2E4.\n\uB3CC\uC544\uAC08 \uAE38\uACFC \uBAB8\uC744 \uD53C\uD560 \uACF3\uC744 \uB208\uC5EC\uACA8\uBD05\uB2C8\uB2E4.\n\uD63C\uC790 \uBC84\uD2F0\uAE30\uBCF4\uB2E4 \uB3D9\uB8CC\uC640 \uD638\uD761\uC744 \uB9DE\uCDA5\uB2C8\uB2E4."
    BagCapacity: 4
    Health: 4
    Aim: 0
    Portrait: {fileID: 21300000, guid: 4532be1ba405411458195b7ad75e67d7, type: 3}
